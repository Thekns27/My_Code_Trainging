// basic function
const add = (a: number, b: number, c?: number): void => {
  console.log(a + b);
};

add(2, 4);

const minus = (a: number, b: number): number => {
  console.log(a - b);
  return a - b;
};
minus(3, 2);

let logger = (): void => {
  console.log("I am logger function");
};
logger();

let loggerTwo = (): void => {
  console.log("i am logger function Two.");
};

loggerTwo();

let loggerThree = (): void => {
  console.log("i am logger function Three.");
};

loggerThree();
